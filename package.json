{
	"name": "vscode-fuzzy-string-grep",
	"displayName": "Fuzzy String Grep",
	"description": "Fuzzy-match user queries against string literals in source code using tree-sitter and fuzzball",
	"version": "0.0.1",
	"publisher": "tmr232",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {},
	"scripts": {
		"build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
		"watch": "bun run build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check . && oxlint",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/vscode": "^1.110.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.27.3",
		"ovsx": "^0.10.9",
		"oxlint": "^1.53.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
