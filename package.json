{
	"name": "vscode-fuzzy-string-search",
	"displayName": "Fuzzy String Search",
	"description": "Fuzzy-match user queries against string literals in source code using tree-sitter and fuzzball",
	"version": "0.1.0",
	"publisher": "tamir-bahar",
	"license": "GPLv3",
	"repository": {
		"type": "git",
		"url": "https://github.com/tmr232/vscode-fuzzy-string-grep"
	},
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "fuzzy-string-search",
					"title": "Fuzzy String Search",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"fuzzy-string-search": [
				{
					"type": "webview",
					"id": "fuzzyStringSearch.searchPanel",
					"name": "Search"
				}
			]
		},
		"configuration": {
			"title": "Fuzzy String Search",
			"properties": {
				"fuzzyStringSearch.defaultScoreCutoff": {
					"type": "number",
					"default": 60,
					"minimum": 0,
					"maximum": 100,
					"description": "Minimum fuzzy match score (0–100) to include in results."
				},
				"fuzzyStringSearch.maxResults": {
					"type": "number",
					"default": 100,
					"minimum": 0,
					"description": "Maximum number of results to return (0 for unlimited)."
				}
			}
		}
	},
	"scripts": {
		"build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --inject:./scripts/import-meta-url.js --define:import.meta.url=import_meta_url",
		"watch": "bun run build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"download-wasm": "bun run scripts/download-wasm.ts",
		"lint": "biome check . && oxlint --ignore-pattern test/fixtures",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"vscode:prepublish": "bun run download-wasm && bun run build",
		"package": "bun run vscode:prepublish && vsce package --no-dependencies"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/vscode": "^1.110.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.27.3",
		"ovsx": "^0.10.9",
		"oxlint": "^1.53.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"fuzzball": "^2.2.3",
		"sql.js": "^1.14.1",
		"tree-sitter-cpp": "^0.23.4",
		"tree-sitter-python": "^0.25.0",
		"tree-sitter-typescript": "^0.23.2",
		"web-tree-sitter": "^0.26.6"
	}
}
