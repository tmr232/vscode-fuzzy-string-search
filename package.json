{
	"name": "vscode-fuzzy-string-grep",
	"displayName": "Fuzzy String Grep",
	"description": "Fuzzy-match user queries against string literals in source code using tree-sitter and fuzzball",
	"version": "0.0.1",
	"publisher": "tmr232",
	"license": "MIT",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "fuzzy-string-grep",
					"title": "Fuzzy String Grep",
					"icon": "$(search)"
				}
			]
		},
		"views": {
			"fuzzy-string-grep": [
				{
					"type": "webview",
					"id": "fuzzyStringGrep.searchPanel",
					"name": "Search"
				}
			]
		},
		"configuration": {
			"title": "Fuzzy String Grep",
			"properties": {
				"fuzzyStringGrep.defaultScoreCutoff": {
					"type": "number",
					"default": 60,
					"minimum": 0,
					"maximum": 100,
					"description": "Minimum fuzzy match score (0–100) to include in results."
				},
				"fuzzyStringGrep.maxResults": {
					"type": "number",
					"default": 100,
					"minimum": 0,
					"description": "Maximum number of results to return (0 for unlimited)."
				}
			}
		}
	},
	"scripts": {
		"build": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
		"watch": "bun run build --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"download-wasm": "bun run scripts/download-wasm.ts",
		"lint": "biome check . && oxlint",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/vscode": "^1.110.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.27.3",
		"ovsx": "^0.10.9",
		"oxlint": "^1.53.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"fuzzball": "^2.2.3",
		"tree-sitter-python": "^0.25.0",
		"web-tree-sitter": "^0.26.6"
	}
}
