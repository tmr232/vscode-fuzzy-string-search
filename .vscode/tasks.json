{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "bun run build",
			"group": "build",
			"problemMatcher": ["$esbuild"]
		},
		{
			"label": "watch",
			"type": "shell",
			"command": "bun run watch",
			"group": "build",
			"isBackground": true,
			"problemMatcher": ["$esbuild-watch"]
		}
	]
}
